# Copy to mobile/.env.local (ignored by git).
# WARNING: every EXPO_PUBLIC_* variable is embedded in the app bundle and is readable by anyone
# who downloads the app. Never put secrets, tokens or API keys here.

# Backend URL as seen from the phone. On a real device use your PC's LAN IP, not localhost:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
