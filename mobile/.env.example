# Copy to mobile/.env.local (ignored by git).
# WARNING: every EXPO_PUBLIC_* variable is embedded in the app bundle (and in the web panel's
# JavaScript) and is readable by anyone. Never put secrets, tokens or API keys here.

# Backend URL as seen from the device running the app.
# - Web panel in this PC's browser: localhost works.
# - Real phone (Expo Go): use your PC's LAN IP, not localhost:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
