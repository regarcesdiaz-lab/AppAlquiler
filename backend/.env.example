# Copy to backend/.env and adjust. Never commit .env. Secrets only live in environment variables.

APP_ENV=development

# Matches docker-compose.yml. For a cloud database, change only these URLs.
DATABASE_URL=postgresql+psycopg://alquilerapp:alquilerapp@localhost:5432/alquilerapp
# Must be a different database: tests refuse to run if it equals DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://alquilerapp:alquilerapp@localhost:5432/alquilerapp_test
REDIS_URL=redis://localhost:6379/0

# Comma-separated. Expo web (8081) and the Next.js site (3000).
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

TIMEZONE=America/Santo_Domingo

# simulator = nothing leaves your machine. live = real WhatsApp/email sends.
MESSAGING_MODE=simulator

# LLM (Anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# WhatsApp Cloud API (central number) — only needed with MESSAGING_MODE=live
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Transactional email: console | resend | postmark | ses
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=

# File storage: local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
